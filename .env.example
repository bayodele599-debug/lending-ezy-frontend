NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_INQUIRIES_ENABLED=false
NEXT_PUBLIC_FINANCING_REQUESTS_ENABLED=false
# Site key is required when public submissions are enabled in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Customer accounts stay disabled on public previews until an API is hosted.
# The private flag controls Next.js account proxy routes; the public flag
# controls navigation/UI and should be enabled only alongside the private flag.
CUSTOMER_PORTAL_ENABLED=false
NEXT_PUBLIC_CUSTOMER_PORTAL_ENABLED=false
INTERNAL_API_URL=http://127.0.0.1:8000
